# 本地复制为 .env.local；Vercel 通过项目设置配置，切勿上传凭据文件。
# 本地使用 Neon 开发分支，Production 使用现有生产分支。
DATABASE_URL=
ADMIN_PASSWORD=
PREVIEW_DEMO=false
PREVIEW_READ_ONLY=true
# 纯域名，多个以逗号分隔，现有两个又拍云域名默认保留。
NEXT_PUBLIC_UPYUN_HOSTS=img.ixzki.com
# 不支持图片处理或使用签名链接时设为 false。
NEXT_PUBLIC_UPYUN_TRANSFORMS=true
IMAGE_REMOTE_HOSTS=

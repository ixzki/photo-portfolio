# 本地复制为 .env.local；Vercel 通过项目设置配置，切勿上传凭据文件。
# 本地使用 Neon 开发分支，Production 使用现有生产分支。
DATABASE_URL=
ADMIN_PASSWORD=
PREVIEW_DEMO=false
PREVIEW_READ_ONLY=true
# 填写你自己的又拍云纯域名（如 cdn.example.com），多个以逗号分隔。
# 没有内置个人图床域名；示例照片使用 Unsplash，无需配置。
NEXT_PUBLIC_UPYUN_HOSTS=
# 不支持图片处理或使用签名链接时设为 false。
NEXT_PUBLIC_UPYUN_TRANSFORMS=true
IMAGE_REMOTE_HOSTS=

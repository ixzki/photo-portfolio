# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-demo/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env example
!.env.example

# local assistant/tooling notes
AGENTS.md
CLAUDE.md
.claude/
.codex/
.cursor/
.windsurf/
.local-preview/
__pycache__/

# Personal imports and exports belong outside the source tree.
*.csv
*.gpx
*.kml
*.kmz
*.sql
*.dump
*.backup
!examples/*.csv
